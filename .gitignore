# Competition data, never published through git
/train/

# Secrets
.env
.env.*
!.env.example

# Python
.venv/
__pycache__/
*.py[cod]
.pytest_cache/
.ruff_cache/
.coverage
htmlcov/

# Node
node_modules/
dist/
*.tsbuildinfo

# Raw eval output can contain answers and cell values
/eval/reports/*
!/eval/reports/.gitkeep

# Runtime data
*.duckdb
*.duckdb.wal

# Personal Claude Code overrides
.claude/settings.local.json
.claude/worktrees/

# Third-party agent skills: reinstall them instead (see README, Development). Skills written for
# this project (tdd, agent-architecture) stay tracked.
/.agents/
/.claude/skills/agent-browser
/.claude/skills/brainstorming
/.claude/skills/design-taste-frontend
/.claude/skills/find-skills
/.claude/skills/frontend-design
/.claude/skills/playwright-cli/

# OS noise
*:Zone.Identifier
.DS_Store
# Playwright CLI output (may contain credentials)
.playwright-cli/
