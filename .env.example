# Copy to .env and fill in. Docker Compose reads it; never commit .env.
# Make each secret with: openssl rand -hex 32

# Required
POSTGRES_PASSWORD=
DA_AGENT_RUNNER_TOKEN=
GROQ_API_KEY=

# Optional
# DA_AGENT_ROUTES=groq:openai/gpt-oss-20b
# DA_AGENT_DAILY_BUDGET_USD=5.0
# DA_AGENT_RUN_BUDGET_USD=0.25
# Wall time for one run; past it the run stops with deadline_exceeded (ADR 0042).
# DA_AGENT_RUN_MAX_SECONDS=300
# Outbound limits per route, kept below the provider's quota (ADR 0041). Compose shares them
# between worker replicas through Postgres; eval runs keep them in memory. Each call reserves its
# output cap (2048 tokens by default), so keep tpm well above it.
# DA_AGENT_ROUTE_LIMITS={"groq:openai/gpt-oss-20b": {"rpm": 30, "tpm": 8000}}
# A route is skipped for the cooldown after this many network failures in a row.
# DA_AGENT_BREAKER_FAILURES=5
# DA_AGENT_BREAKER_COOLDOWN_SECONDS=30
# DA_AGENT_WEB_PORT=8080
# DA_AGENT_PHOENIX_PORT=6006
# Alerts (ADR 0044): Alertmanager posts its JSON here, for example a Slack-compatible webhook or
# a small adapter for Telegram. Unset: alerts show only in Alertmanager and on the ops dashboard.
# DA_AGENT_ALERT_WEBHOOK_URL=https://hooks.example.com/...
# DA_AGENT_PROMETHEUS_PORT=9090
# DA_AGENT_ALERTMANAGER_PORT=9093
# Adds "Open trace" links to runs. Phoenix shows every workspace's traces: set this only when the
# operator is the only user.
# DA_AGENT_TRACE_UI_URL=http://127.0.0.1:6006
# Where browsers open the UI. Login links point here; https makes the session cookie Secure.
# DA_AGENT_PUBLIC_URL=http://127.0.0.1:8080
# Run released images instead of building them (docker compose pull, then up -d --no-build).
# DA_AGENT_IMAGE=ghcr.io/qnghi13/da-agent
# DA_AGENT_TAG=0.1.0
