# Copy to .env and fill in. Docker Compose reads it; never commit .env.
# Make each secret with: openssl rand -hex 32

# Required
POSTGRES_PASSWORD=
DA_AGENT_RUNNER_TOKEN=
GROQ_API_KEY=

# Optional
# DA_AGENT_ROUTES=groq:openai/gpt-oss-20b
# DA_AGENT_DAILY_BUDGET_USD=5.0
# DA_AGENT_RUN_BUDGET_USD=0.25
# DA_AGENT_WEB_PORT=8080
# DA_AGENT_PHOENIX_PORT=6006
# Adds "Open trace" links to runs. Phoenix shows every workspace's traces: set this only when the
# operator is the only user.
# DA_AGENT_TRACE_UI_URL=http://127.0.0.1:6006
